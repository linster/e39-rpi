<configuration>

    <!-- Systemd journal when the HMI runs as the systemd service (see
         ca.stefanm.ibus.lib.logging.Journald), otherwise stdout with this
         pattern, like a ConsoleAppender. -->
    <appender name="STDOUT" class="ca.stefanm.ibus.lib.logging.JournaldAppender">
        <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </appender>

    <logger name="com" level="INFO" />
    <logger name="org" level="DEBUG" />
    <logger name="org.freedesktop.dbus.connections" level="ERROR" />
    <logger name="org.freedesktop.dbus.connections.impl.DirectConnection" level="ERROR" />
    <logger name="org.freedesktop.dbus.connections.IncomingMessageThread" level="ERROR" />
    <logger name="org.freedesktop.dbus.connections.transports.TransportBuilder" level="ERROR" />
    <logger name="org.freedesktop.dbus.errors" level="ERROR" />
    <logger name="org.freedesktop.dbus.messages" level="ERROR" />
    <logger name="org.freedesktop.dbus.MessageWriter" level="ERROR" />
    <logger name="org.freedesktop.dbus.connections.SASL" level="ERROR" />
    <logger name="org.freedesktop.dbus.connections.ReceivingService" level="ERROR" />

    <logger name="org.freedesktop.dbus.bin" level="ERROR" />

    <root level="TRACE">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
